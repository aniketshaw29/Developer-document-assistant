# Copy this file to `.env` and fill in your own values.
# At least one LLM provider is required: OpenAI, Anthropic, or local Ollama.

# === LLM providers ===
# OpenAI key (chat + embeddings). Leave empty if you only use Ollama.
OPENAI_API_KEY=sk-...
# Anthropic key (chat only — Anthropic has no embeddings, OpenAI is used for those).
ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini key (chat only — obtain at https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=AIza...
# Ollama runs locally, no key required.
OLLAMA_BASE_URL=http://localhost:11434

# === Default provider / model ===
# Provider used when none is specified: openai | anthropic | ollama
DEFAULT_PROVIDER=openai
# Model name for the default provider (e.g. gpt-4o, claude-sonnet-4, llama3.1)
DEFAULT_MODEL=gpt-4o
# Embedding model. OpenAI is the default; Ollama uses "nomic-embed-text".
EMBEDDING_MODEL=text-embedding-3-small

# === Storage ===
# Where ChromaDB persists vectors. Path is relative to the backend/ dir.
CHROMA_PERSIST_DIR=../data/chroma

# === Server ===
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Logging level: debug | info | warning | error
LOG_LEVEL=info

# === Rate limiting ===
# Maximum requests per client IP within the window below.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
