# Copy this file to `.env` and fill in your own values.
#
# Two ways to connect an LLM:
#
#   1. GATEWAY (recommended) — one OpenAI-compatible endpoint (e.g. a LiteLLM
#      proxy) serves every model behind one key. Set LLM_BASE_URL + LLM_API_KEY
#      and any model the gateway exposes just works (chat AND embeddings).
#
#   2. DIRECT — leave LLM_BASE_URL empty and set an individual provider key
#      below (OpenAI / Anthropic / Gemini) or run Ollama locally.

# === LLM gateway (OpenAI-compatible endpoint) ===
# Full base URL including the version path, e.g. a LiteLLM proxy:
LLM_BASE_URL=http://localhost:4000/v1
# Virtual key the gateway requires:
LLM_API_KEY=sk-...
# Default chat model when the client doesn't pick one (any id from the catalog):
LLM_MODEL=gpt-4o
# Embedding model id exposed by the gateway:
EMBEDDING_MODEL=text-embedding-3-small

# === Direct providers (used only when LLM_BASE_URL is empty) ===
# OpenAI key (chat + embeddings).
OPENAI_API_KEY=sk-...
# Anthropic key (chat only — Anthropic has no embeddings, OpenAI is used for those).
ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini key (obtain at https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=AIza...
# Ollama runs locally, no key required.
OLLAMA_BASE_URL=http://localhost:11434

# === Default provider / model (direct mode only) ===
# Provider used when none is specified: openai | anthropic | gemini | ollama
DEFAULT_PROVIDER=openai
# Model name for the default provider (e.g. gpt-4o, claude-sonnet-5-5, llama3.1)
DEFAULT_MODEL=gpt-4o

# === Storage ===
# Where ChromaDB persists vectors. Path is relative to the backend/ dir.
CHROMA_PERSIST_DIR=../data/chroma

# === Server ===
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Logging level: debug | info | warning | error
LOG_LEVEL=info

# === Rate limiting ===
# Maximum requests per client IP within the window below.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
